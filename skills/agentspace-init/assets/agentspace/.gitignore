# ---- 实验数据: 全量本地保存, 不入 git ----
iterations/*/data/

# ---- 公用数据: 全部不入 git (训练集/模型权重/软连接等) ----
data/

# ---- 其他不由 agent 生成/改动的内容, 按项目需要取消注释/补充 ----
# *.log
# *.out
# __pycache__/
# .ipynb_checkpoints/
# wandb/
# checkpoints/
# runs/

# ---- 脚本并发锁与临时目录(运行产物; 被强杀时可能残留, 不应入 git) ----
.scripts.lock/
.scripts-tmp.*/

.DS_Store

# ---- 一次性会话交接文件(读后即销毁; index.md 仍入 git) ----
handoff/handoff_*.md

# ---- 并行协同工作区表(运行数据; 由 scripts/parallel-workspace.sh 维护, 不入 git) ----
.agentspace-parallel-workspace.txt
